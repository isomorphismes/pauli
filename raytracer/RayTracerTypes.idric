module RayTracerTypes

%default total
%unbound_implicits off

-- Type-system sketch for a Pauli ray tracer.
--
-- This intentionally stops before numerical implementation.  The purpose of
-- the first Idriç pass is to make the important distinctions visible in types
-- before choosing one particular ray/surface intersection algorithm.

public export
choice coordinate_space one_of
  camera_space
  clipping_space
  surface_space

-- --------------------------------------------------------------------------
-- Geometry and Stussak's shared-parameter ray idea
-- --------------------------------------------------------------------------

public export
data Point3 : Type → coordinate_space → Type where
  Point :
    {number : Type} →
    {space : coordinate_space} →
    number → number → number →
    Point3 number space

public export
data Direction3 : Type → coordinate_space → Type where
  Direction :
    {number : Type} →
    {space : coordinate_space} →
    number → number → number →
    Direction3 number space

-- The differential of a scalar field is a covector.  Do not silently identify
-- it with a direction before a geometric map has supplied that identification.
public export
data Covector3 : Type → coordinate_space → Type where
  Covector :
    {number : Type} →
    {space : coordinate_space} →
    number → number → number →
    Covector3 number space

public export
data Ray : Type → coordinate_space → Type where
  RayFrom :
    {number : Type} →
    {space : coordinate_space} →
    Point3 number space →
    Direction3 number space →
    Ray number space

public export
RayParameter : Type → Type
RayParameter number = number

public export
ViewDirection : Type → Type
ViewDirection number =
  Direction3 number camera_space

public export
CameraNormal : Type → Type
CameraNormal number =
  Direction3 number camera_space

-- These are semantic map types.  The first pass deliberately does not commit
-- them to matrices, quaternions, closures, or a storage ABI.
public export
CoordinateMap :
  Type → coordinate_space → coordinate_space → Type
CoordinateMap number source_space target_space =
  Point3 number source_space →
  Point3 number target_space

public export
DirectionMap :
  Type → coordinate_space → coordinate_space → Type
DirectionMap number source_space target_space =
  Direction3 number source_space →
  Direction3 number target_space

public export
SurfaceNormalTransformer : Type → Type
SurfaceNormalTransformer number =
  Covector3 number surface_space →
  CameraNormal number

public export
data EyeLocationOnRay : Type → Type where
  EyeAt :
    {number : Type} →
    RayParameter number →
    EyeLocationOnRay number

-- Stussak's RayCreator keeps camera-, clipping-, and surface-space rays tied to
-- one parameter t.  That idea is useful independently of his Java classes.
-- The normal transformation remains a separate stage rather than a stored
-- closure inside the bundle.
public export
data RayBundle : Type → Type where
  SameParameterRays :
    {number : Type} →
    Ray number camera_space →
    Ray number clipping_space →
    Ray number surface_space →
    EyeLocationOnRay number →
    RayBundle number

public export
data ViewSample : Type → Type where
  SampleAt :
    {number : Type} →
    number → number →
    ViewSample number

public export
RayCreator : Type → Type
RayCreator number =
  ViewSample number →
  RayBundle number

-- --------------------------------------------------------------------------
-- Clipping and generic surface intersection
-- --------------------------------------------------------------------------

public export
data RayInterval : Type → Type where
  Between :
    {number : Type} →
    number →
    number →
    RayInterval number

public export
data ClipResult : Type → Type where
  OutsideClip :
    {number : Type} →
    ClipResult number
  VisibleInterval :
    {number : Type} →
    RayInterval number →
    ClipResult number

public export
RayClipper : Type → Type
RayClipper number =
  Ray number clipping_space →
  ClipResult number

public export
data FirstHit : Type → Type where
  NoHit :
    {number : Type} →
    FirstHit number
  HitAt :
    {number : Type} →
    RayParameter number →
    FirstHit number

-- The core tracer does not assume that every surface is polynomial.
-- A surface representation supplies its own first-intersection operation.
public export
SurfaceIntersector : Type → Type → Type
SurfaceIntersector surface_description number =
  surface_description →
  Ray number surface_space →
  RayInterval number →
  FirstHit number

-- --------------------------------------------------------------------------
-- General level-set surfaces
-- --------------------------------------------------------------------------

-- A hydrogen-orbital visualization may derive a real field from a complex
-- state, for example a density or another chosen observable, and then render a
-- level set of that field.  That is not generally an algebraic polynomial.

public export
SurfaceValue : Type → Type
SurfaceValue number =
  Point3 number surface_space →
  number

public export
SurfaceDifferential : Type → Type
SurfaceDifferential number =
  Point3 number surface_space →
  Covector3 number surface_space

public export
data LevelSetSurface : Type → Type where
  LevelSet :
    {number : Type} →
    number →
    SurfaceValue number →
    SurfaceDifferential number →
    LevelSetSurface number

-- --------------------------------------------------------------------------
-- Stussak-style algebraic surface specialization
-- --------------------------------------------------------------------------

public export
choice algebraic_root_method one_of
  linear_closed_form
  sign_variation_subdivision

public export
data Powers3 = Powers Number Number Number

public export
data SparseTerm : Type → Type where
  Term :
    {number : Type} →
    number →
    Powers3 →
    SparseTerm number

public export
data SparsePolynomial : Type → Type where
  SparseTerms :
    {number : Type} →
    List (SparseTerm number) →
    SparsePolynomial number

-- This is one surface representation, not the definition of a ray-traceable
-- surface.  It preserves the useful PreparedSurface idea for algebraic work.
public export
data PreparedAlgebraicSurface : Type → Type where
  PreparedAlgebraic :
    {number : Type} →
    Number →
    SparsePolynomial number →
    SparsePolynomial number →
    SparsePolynomial number →
    SparsePolynomial number →
    PreparedAlgebraicSurface number

public export
data UnivariatePolynomial : Type → Type where
  Coefficients :
    {number : Type} →
    List number →
    UnivariatePolynomial number

public export
AlgebraicSurfaceSpecializer : Type → Type
AlgebraicSurfaceSpecializer number =
  PreparedAlgebraicSurface number →
  Ray number surface_space →
  UnivariatePolynomial number

public export
AlgebraicFirstRootFinder : Type → Type
AlgebraicFirstRootFinder number =
  algebraic_root_method →
  UnivariatePolynomial number →
  RayInterval number →
  FirstHit number

-- --------------------------------------------------------------------------
-- Scene and output
-- --------------------------------------------------------------------------

public export
data Color3 : Type → Type where
  RGB :
    {color_number : Type} →
    color_number →
    color_number →
    color_number →
    Color3 color_number

public export
data Material : Type → Type where
  SurfaceMaterial :
    {color_number : Type} →
    Color3 color_number →
    color_number →
    color_number →
    color_number →
    color_number →
    Material color_number

public export
data Light : Type → Type → Type where
  PointLight :
    {geometry_number : Type} →
    {color_number : Type} →
    Point3 geometry_number camera_space →
    Color3 color_number →
    color_number →
    Light geometry_number color_number

-- The surface representation is a parameter of the scene.  A level-set field,
-- a prepared algebraic surface, or a later representation can use the same
-- camera/material/light side of the tracer.
public export
data Scene : Type → Type → Type → Type where
  SurfaceScene :
    {surface_description : Type} →
    {geometry_number : Type} →
    {color_number : Type} →
    surface_description →
    Material color_number →
    Material color_number →
    Color3 color_number →
    List (Light geometry_number color_number) →
    Scene surface_description geometry_number color_number

public export
data TraceResult : Type → Type → Type where
  Background :
    {geometry_number : Type} →
    {color_number : Type} →
    Color3 color_number →
    TraceResult geometry_number color_number
  SurfaceHit :
    {geometry_number : Type} →
    {color_number : Type} →
    RayParameter geometry_number →
    Point3 geometry_number camera_space →
    CameraNormal geometry_number →
    Color3 color_number →
    TraceResult geometry_number color_number

public export
Shader : Type → Type → Type → Type
Shader surface_description geometry_number color_number =
  Scene surface_description geometry_number color_number →
  Point3 geometry_number camera_space →
  ViewDirection geometry_number →
  CameraNormal geometry_number →
  Color3 color_number

-- The whole tracer is a composition boundary: give it the intersection
-- behavior for the chosen surface representation, then a scene and ray bundle.
public export
RayTracer : Type → Type → Type → Type
RayTracer surface_description geometry_number color_number =
  SurfaceIntersector surface_description geometry_number →
  SurfaceNormalTransformer geometry_number →
  Scene surface_description geometry_number color_number →
  RayBundle geometry_number →
  TraceResult geometry_number color_number
